# --- Database (Prisma Postgres) ---
# Provisioned via the Vercel Marketplace (`vercel integration add prisma/prisma-postgres`)
# or a local Postgres instance for standalone dev.
DATABASE_URL="postgresql://user:password@localhost:5432/mydb?schema=public"

# --- Auth.js / NextAuth session secret ---
# Generate your own with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-random-32-byte-base64-secret"
NEXTAUTH_URL="http://localhost:3000"

# --- Stripe (test mode) ---
# Optional. Leave unset to run checkout in simulated-payment demo mode.
# Get test keys from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
# Optional. Only needed if you register a webhook endpoint in the Stripe
# dashboard (checkout.session.completed) for a deployed instance.
STRIPE_WEBHOOK_SECRET=""
